fix even (a : nat) : bool :=
  match a return bool with
  | O => true
  | S a0 => odd a0
  end
with odd (a : nat) : bool :=
  match a return bool with
  | O => false
  | S a0 => even a0
  end
for
even
     : forall _ : nat, bool


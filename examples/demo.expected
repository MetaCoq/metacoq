(fix add (n m : nat) {struct n} : nat :=
   match n return nat with
   | Datatypes.O => m
   | Datatypes.S p => Datatypes.S (add p m)
   end)
(fix add (a b : nat) {struct a} : nat :=
   match a return nat with
   | Datatypes.O => b
   | Datatypes.S a0 => Datatypes.S (add a0 b)
   end)

Inductive term : Type :=
    tRel : forall _ : nat, term
  | tVar : forall _ : ident, term
  | tEvar : forall (_ : nat) (_ : list term), term
  | tSort : forall _ : Sort.t, term
  | tCast : forall (_ : term) (_ : cast_kind) (_ : term), term
  | tProd : forall (_ : aname) (_ : term) (_ : term), term
  | tLambda : forall (_ : aname) (_ : term) (_ : term), term
  | tLetIn : forall (_ : aname) (_ : term) (_ : term) (_ : term), term
  | tApp : forall (_ : term) (_ : list term), term
  | tConst : forall (_ : kername) (_ : Instance.t), term
  | tInd : forall (_ : inductive) (_ : Instance.t), term
  | tConstruct : forall (_ : inductive) (_ : nat) (_ : Instance.t), term
  | tCase : forall (_ : case_info) (_ : predicate term) 
              (_ : term) (_ : list (branch term)),
            term
  | tProj : forall (_ : projection) (_ : term), term
  | tFix : forall (_ : mfixpoint term) (_ : nat), term
  | tCoFix : forall (_ : mfixpoint term) (_ : nat), term
  | tInt : forall _ : PrimInt63.int, term
  | tFloat : forall _ : PrimFloat.float, term
  | tString : forall _ : PrimString.string, term
  | tArray : forall (_ : Universe.t) (_ : list term) (_ : term) (_ : term),
             term.

Arguments tRel n%_nat_scope
Arguments tVar id
Arguments tEvar ev%_nat_scope args%_list_scope
Arguments tSort s
Arguments tCast t kind v
Arguments tProd na ty body
Arguments tLambda na ty body
Arguments tLetIn na def def_ty body
Arguments tApp f args%_list_scope
Arguments tConst c u
Arguments tInd ind u
Arguments tConstruct ind idx%_nat_scope u
Arguments tCase ci type_info discr branches%_list_scope
Arguments tProj proj t
Arguments tFix mfix idx%_nat_scope
Arguments tCoFix mfix idx%_nat_scope
Arguments tInt i
Arguments tFloat f
Arguments tString s
Arguments tArray u arr%_list_scope default type
tCase
     : forall (_ : case_info) (_ : predicate term) 
         (_ : term) (_ : list (branch term)),
       term

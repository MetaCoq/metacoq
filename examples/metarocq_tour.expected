Inductive term : Type :=
    tRel : nat -> Ast.term
  | tVar : ident -> Ast.term
  | tEvar : nat -> list Ast.term -> Ast.term
  | tSort : sort -> Ast.term
  | tCast : Ast.term -> cast_kind -> Ast.term -> Ast.term
  | tProd : aname -> Ast.term -> Ast.term -> Ast.term
  | tLambda : aname -> Ast.term -> Ast.term -> Ast.term
  | tLetIn : aname -> Ast.term -> Ast.term -> Ast.term -> Ast.term
  | tApp : Ast.term -> list Ast.term -> Ast.term
  | tConst : kername -> Instance.t -> Ast.term
  | tInd : inductive -> Instance.t -> Ast.term
  | tConstruct : inductive -> nat -> Instance.t -> Ast.term
  | tCase : case_info ->
            Ast.predicate Ast.term ->
            Ast.term -> list (Ast.branch Ast.term) -> Ast.term
  | tProj : projection -> Ast.term -> Ast.term
  | tFix : mfixpoint Ast.term -> nat -> Ast.term
  | tCoFix : mfixpoint Ast.term -> nat -> Ast.term
  | tInt : PrimInt63.int -> Ast.term
  | tFloat : PrimFloat.float -> Ast.term
  | tString : PrimString.string -> Ast.term
  | tArray : Universe.t -> list Ast.term -> Ast.term -> Ast.term -> Ast.term.


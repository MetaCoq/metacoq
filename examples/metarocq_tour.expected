Arguments type_Rel {H} Σ Γ n%_nat_scope decl _ _
Arguments type_Sort {H} Σ Γ s _ _
Arguments type_Prod {H} Σ Γ na A B s1 s2 _ _
Arguments type_Lambda {H} Σ Γ na A t B _ _
Arguments type_LetIn {H} Σ Γ na b B t A _ _
Arguments type_App {H} Σ Γ t na A B s u _ _ _
Arguments type_Const {H} Σ Γ cst u decl _ _ _
Arguments type_Ind {H} Σ Γ ind u mdecl idecl _ _ _
Arguments type_Construct {H} Σ Γ ind i%_nat_scope u mdecl idecl cdecl _ _ _
Arguments type_Case {H} Σ Γ ci p c (brs indices)%_list_scope 
  ps mdecl idecl _ _ _ _ _
Arguments type_Proj {H} Σ Γ p c u mdecl idecl cdecl 
  pdecl args%_list_scope _ _ _
Arguments type_Fix {H} Σ Γ mfix n%_nat_scope decl _ _ _ _ _ _
Arguments type_CoFix {H} Σ Γ mfix n%_nat_scope decl _ _ _ _ _ _
Arguments type_Prim {H} Σ Γ p prim_ty cdecl _ _ _ _ _
Arguments type_Cumul {H} Σ Γ t A B s _ _ _
type_Sort
     : forall (Σ : global_env_ext) (Γ : context) (s : sort),
       wf_local Σ Γ ->
       wf_sort Σ s -> Σ;;; Γ |- tSort s : tSort (Sort.super s)
where
?H : [ |- checker_flags]
type_LetIn
     : forall (Σ : global_env_ext) (Γ : context) (na : binder_annot name)
         (b B t A : term),
       lift_typing0 (typing Σ Γ) (j_vdef na b B) ->
       Σ;;; Γ,, vdef na b B |- t : A ->
       Σ;;; Γ |- tLetIn na b B t : tLetIn na b B A
where
?H : [ |- checker_flags]
type_Const
     : forall (Σ : global_env_ext) (Γ : context) (cst : kername)
         (u : Instance.t) (decl : constant_body),
       wf_local Σ Γ ->
       declared_constant Σ cst decl ->
       consistent_instance_ext Σ (cst_universes decl) u ->
       Σ;;; Γ |- tConst cst u : (cst_type decl)@[u]
where
?H : [ |- checker_flags]
PCUICSR.subject_reduction
     : forall (Σ : global_env_ext) (Γ : context) (t u T : term),
       wf Σ -> Σ;;; Γ |- t : T -> Σ;;; Γ |- t ⇝* u -> Σ;;; Γ |- u : T
where
?cf : [ |- checker_flags]
PCUICSafeConversion.isconv_term_sound
     : forall (X_type : abstract_env_impl) (X : (X_type.π2).π1)
         (normalization_in : forall Σ : global_env_ext,
                             wf_ext Σ ->
                             Σ ∼_ext X -> PCUICSN.NormalizationIn Σ)
         (Σ : global_env_ext),
       Σ ∼_ext X ->
       forall (Γ : context) (leq : conv_pb) (t1 : term)
         (h1 : forall Σ0 : global_env_ext, Σ0 ∼_ext X -> welltyped Σ0 Γ t1)
         (t2 : term)
         (h2 : forall Σ0 : global_env_ext, Σ0 ∼_ext X -> welltyped Σ0 Γ t2),
       PCUICSafeConversion.isconv_term X_type X Γ leq t1 h1 t2 h2 =
       PCUICSafeConversion.ConvSuccess ->
       PCUICConvCumInversion.conv_cum leq Σ Γ t1 t2
where
?cf : [ |- checker_flags]
?nor : [ |- PCUICSN.normalizing_flags]
PCUICSafeConversion.isconv_term_complete
     : forall (X_type : abstract_env_impl) (X : (X_type.π2).π1)
         (normalization_in : forall Σ : global_env_ext,
                             wf_ext Σ ->
                             Σ ∼_ext X -> PCUICSN.NormalizationIn Σ)
         (Σ : global_env_ext),
       Σ ∼_ext X ->
       forall (Γ : context) (leq : conv_pb) (t1 : term)
         (h1 : forall Σ0 : global_env_ext, Σ0 ∼_ext X -> welltyped Σ0 Γ t1)
         (t2 : term)
         (h2 : forall Σ0 : global_env_ext, Σ0 ∼_ext X -> welltyped Σ0 Γ t2)
         (e : ConversionError),
       PCUICSafeConversion.isconv_term X_type X Γ leq t1 h1 t2 h2 =
       PCUICSafeConversion.ConvError e ->
       ~ PCUICConvCumInversion.conv_cum leq Σ Γ t1 t2
where
?cf : [ |- checker_flags]
?nor : [ |- PCUICSN.normalizing_flags]
infer_wf_env
     : forall (X_impl : abstract_env_impl) (X_ext : X_env_ext_type X_impl),
       (forall Σ : global_env_ext,
        wf_ext Σ -> Σ ∼_ext X_ext -> PCUICSN.NormalizationIn Σ) ->
       forall Γ : context,
       (forall Σ : global_env_ext, Σ ∼_ext X_ext -> ∥ wf_local Σ Γ ∥) ->
       forall t : term,
       typing_result
         (∑ T : term,
            forall Σ : global_env_ext,
            Σ ∼_ext X_ext -> ∥ BDTyping.infering Σ Γ t T ∥)
where
?cf : [ |- checker_flags]
?nor : [ |- PCUICSN.normalizing_flags]
type_of
     : forall (X_type : abstract_env_impl) (X : (X_type.π2).π1),
       (forall Σ : global_env_ext,
        wf_ext Σ -> Σ ∼_ext X -> PCUICSN.NormalizationIn Σ) ->
       forall Γ : context,
       (forall Σ : global_env_ext, Σ ∼_ext X -> ∥ wf_local Σ Γ ∥) ->
       forall t : term,
       (forall Σ : global_env_ext, Σ ∼_ext X -> wellinferred Σ Γ t) -> term
where
?cf : [ |- checker_flags]
?nor : [ |- PCUICSN.normalizing_flags]
type_of_subtype
     : forall (X_type : abstract_env_impl) (X : (X_type.π2).π1)
         (normalization_in : forall Σ : global_env_ext,
                             wf_ext Σ ->
                             Σ ∼_ext X -> PCUICSN.NormalizationIn Σ)
         (Γ : context) (t T : term)
         (wt : forall Σ : global_env_ext, Σ ∼_ext X -> ∥ Σ;;; Γ |- t : T ∥)
         (Σ : global_env_ext) (wfΣ : Σ ∼_ext X),
       ∥ PCUICWellScopedCumulativity.ws_cumul_pb Cumul Σ Γ
           (type_of X_type X Γ
              (type_of_subtype_obligation_1 X_type X Γ t T wt Σ wfΣ) t
              (type_of_subtype_obligation_2 X_type X Γ t T wt Σ wfΣ))
           T
       ∥
where
?cf : [ |- checker_flags]
?nor : [ |- PCUICSN.normalizing_flags]
check_inh
     : forall (Σ : wf_env_ext) (Γ : context),
       (forall Σ0 : global_env_ext, Σ0 ∼_ext Σ -> ∥ wf_local Σ0 Γ ∥) ->
       term -> forall T : term, typing_result (inh Σ Γ T)

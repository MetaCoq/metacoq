Inductive
typing (H : checker_flags) (Σ : global_env_ext) (Γ : context)
  : term -> term -> Type :=
    type_Rel : forall (n : nat) (decl : context_decl),
               wf_local Σ Γ ->
               nth_error Γ n = Some decl ->
               Σ;;; Γ |- tRel n : lift0 (S n) (decl_type decl)
  | type_Sort : forall s : sort,
                wf_local Σ Γ ->
                wf_sort Σ s -> Σ;;; Γ |- tSort s : tSort (Sort.super s)
  | type_Prod : forall (na : binder_annot name) (A B : term) (s1 s2 : sort),
                lift_typing typing Σ Γ (j_vass_s na A s1) ->
                Σ;;; Γ,, vass na A |- B : tSort s2 ->
                Σ;;; Γ |- tProd na A B : tSort (Sort.sort_of_product s1 s2)
  | type_Lambda : forall (na : binder_annot name) (A t B : term),
                  lift_typing typing Σ Γ (j_vass na A) ->
                  Σ;;; Γ,, vass na A |- t : B ->
                  Σ;;; Γ |- tLambda na A t : tProd na A B
  | type_LetIn : forall (na : binder_annot name) (b B t A : term),
                 lift_typing typing Σ Γ (j_vdef na b B) ->
                 Σ;;; Γ,, vdef na b B |- t : A ->
                 Σ;;; Γ |- tLetIn na b B t : tLetIn na b B A
  | type_App : forall (t : term) (na : aname) (A B : term) 
                 (s : sort) (u : term),
               Σ;;; Γ |- tProd na A B : tSort s ->
               Σ;;; Γ |- t : tProd na A B ->
               Σ;;; Γ |- u : A -> Σ;;; Γ |- tApp t u : B {0 := u}
  | type_Const : forall (cst : kername) (u : Instance.t)
                   (decl : constant_body),
                 wf_local Σ Γ ->
                 declared_constant Σ cst decl ->
                 consistent_instance_ext Σ (cst_universes decl) u ->
                 Σ;;; Γ |- tConst cst u : (cst_type decl)@[u]
  | type_Ind : forall (ind : inductive) (u : Instance.t)
                 (mdecl : mutual_inductive_body) (idecl : one_inductive_body),
               wf_local Σ Γ ->
               declared_inductive Σ ind mdecl idecl ->
               consistent_instance_ext Σ (ind_universes mdecl) u ->
               Σ;;; Γ |- tInd ind u : (ind_type idecl)@[u]
  | type_Construct : forall (ind : inductive) (i : nat) 
                       (u : Instance.t) (mdecl : mutual_inductive_body)
                       (idecl : one_inductive_body)
                       (cdecl : constructor_body),
                     wf_local Σ Γ ->
                     declared_constructor Σ (ind, i) mdecl idecl cdecl ->
                     consistent_instance_ext Σ (ind_universes mdecl) u ->
                     Σ;;; Γ |- tConstruct ind i u
                     : type_of_constructor mdecl cdecl (ind, i) u
  | type_Case : forall (ci : case_info) (p : predicate term) 
                  (c : term) (brs : list (branch term)) 
                  (indices : list term) (ps : sort)
                  (mdecl : mutual_inductive_body)
                  (idecl : one_inductive_body),
                let predctx := case_predicate_context ci mdecl idecl p in
                let ptm := it_mkLambda_or_LetIn predctx (preturn p) in
                declared_inductive Σ ci mdecl idecl ->
                Σ;;; Γ,,, predctx |- preturn p : tSort ps ->
                Σ;;; Γ |- c
                : mkApps (tInd ci (puinst p)) (pparams p ++ indices) ->
                case_side_conditions
                  (fun Γ : list context_decl => wf_local Σ Γ) 
                  (typing Σ) Σ Γ ci p ps mdecl idecl indices predctx ->
                case_branch_typing
                  (fun Γ : list context_decl => wf_local Σ Γ) 
                  (typing Σ) Γ ci p ps mdecl idecl ptm brs ->
                Σ;;; Γ |- tCase ci p c brs : mkApps ptm (indices ++ [c])
  | type_Proj : forall (p : projection) (c : term) 
                  (u : Instance.t) (mdecl : mutual_inductive_body)
                  (idecl : one_inductive_body) (cdecl : constructor_body)
                  (pdecl : projection_body) (args : list term),
                declared_projection Σ p mdecl idecl cdecl pdecl ->
                Σ;;; Γ |- c : mkApps (tInd (proj_ind p) u) args ->
                #|args| = ind_npars mdecl ->
                Σ;;; Γ |- tProj p c
                : subst0 (c :: List.rev args) (proj_type pdecl)@[u]
  | type_Fix : forall (mfix : mfixpoint term) (n : nat) (decl : def term),
               wf_local Σ Γ ->
               fix_guard Σ Γ mfix ->
               nth_error mfix n = Some decl ->
               All (on_def_type (lift_typing1 (typing Σ)) Γ) mfix ->
               All
                 (on_def_body (lift_typing1 (typing Σ)) (fix_context mfix) Γ)
                 mfix ->
               wf_fixpoint Σ mfix -> Σ;;; Γ |- tFix mfix n : dtype decl
  | type_CoFix : forall (mfix : mfixpoint term) (n : nat) (decl : def term),
                 wf_local Σ Γ ->
                 cofix_guard Σ Γ mfix ->
                 nth_error mfix n = Some decl ->
                 All (on_def_type (lift_typing1 (typing Σ)) Γ) mfix ->
                 All
                   (on_def_body (lift_typing1 (typing Σ)) 
                      (fix_context mfix) Γ)
                   mfix ->
                 wf_cofixpoint Σ mfix -> Σ;;; Γ |- tCoFix mfix n : dtype decl
  | type_Prim : forall (p : prim_val) (prim_ty : kername)
                  (cdecl : constant_body),
                wf_local Σ Γ ->
                primitive_constant Σ (prim_val_tag p) = Some prim_ty ->
                declared_constant Σ prim_ty cdecl ->
                primitive_invariants (prim_val_tag p) cdecl ->
                primitive_typing_hyps (typing Σ) Σ Γ p ->
                Σ;;; Γ |- tPrim p : prim_type p prim_ty
  | type_Cumul : forall (t A B : term) (s : sort),
                 Σ;;; Γ |- t : A ->
                 Σ;;; Γ |- B : tSort s ->
                 Σ;;; Γ |- A <=s B -> Σ;;; Γ |- t : B.


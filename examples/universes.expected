erefl : check_model ("a" ≤ "b")
     : check_model ("a" ≤ "b")
erefl : check_model ("b" ≤ "c")
     : check_model ("b" ≤ "c")
erefl : check_model ("a" + 1 ≤ "c")
     : check_model ("a" + 1 ≤ "c")
erefl : check_model ("a" + 2 ≤ "c") = false
     : check_model ("a" + 2 ≤ "c") = false
erefl : check_model ("b" + 1 ≤ "a") = false
     : check_model ("b" + 1 ≤ "a") = false
erefl : check_model ("b" + 1 ≤ "a") = false
     : check_model ("b" + 1 ≤ "a") = false
erefl : check_model ("a" ⊔ "b" ≤ "b" + 1)
     : check_model ("a" ⊔ "b" ≤ "b" + 1)
erefl : check_model ("a" ⊔ "a" + 1 = "a" + 1)
     : check_model ("a" ⊔ "a" + 1 = "a" + 1)
erefl : check_model ("a" ⊔ "a" + 1 = "a") = false
     : check_model ("a" ⊔ "a" + 1 = "a") = false
erefl : check_model ("a" ≤ ("a" ⊔ "b") ⊔ "b" + 1)
     : check_model ("a" ≤ ("a" ⊔ "b") ⊔ "b" + 1)

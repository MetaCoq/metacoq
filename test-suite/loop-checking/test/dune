(rocq.theory
 (name MetaRocq.LoopCheckingTest)
 (theories
  Stdlib Ltac2 Equations ExtLib MetaRocq.Utils MetaRocq.Common
  MetaRocq.Template MetaRocq.LoopChecking))

; The output of the test depends on the universes of the Stdlib, so it is not
; checked. To keep it off the terminal, generate test.expected as a copy of
; it: dune then writes the output of test.v to test.output in _build, and the
; comparison of `dune test` always succeeds.

(rule
 (copy test.output test.expected))

(rule
 (alias runtest)
 (deps
  (alias_rec all))
 (action
  (progn)))

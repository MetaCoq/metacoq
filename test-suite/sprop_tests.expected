        {|
          inductive_mind := (MPfile ["Datatypes"; "Init"; "Corelib"], "nat");
          inductive_ind := 0
        |} [])
     (tLambda {| binder_name := nNamed "p"; binder_relevance := Irrelevant |}
        (tApp
           (tInd
              {|
                inductive_mind :=
                  (MPfile ["sprop_tests"; "TestSuite"; "MetaRocq"], "sle");
                inductive_ind := 0
              |} [])
           [tRel 1; tRel 0])
        (tLambda
           {| binder_name := nNamed "q"; binder_relevance := Irrelevant |}
           (tApp
              (tInd
                 {|
                   inductive_mind :=
                     (MPfile ["sprop_tests"; "TestSuite"; "MetaRocq"], "sle");
                   inductive_ind := 0
                 |} [])
              [tRel 2; tRel 1])
           (tApp
              (tConstruct

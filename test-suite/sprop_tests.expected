                            "sle");
                         inductive_ind := 0
                       |} [])
                    [tRel 3; tRel 2]];
               tApp
                 (tConstruct
                    {|
                      inductive_mind :=
                        (MPfile ["sprop_tests"; "TestSuite"; "MetaRocq"],
                         "sBox");
                      inductive_ind := 0
                    |} 0 [])
                 [tApp
                    (tInd
                       {|
                         inductive_mind :=
                           (MPfile ["sprop_tests"; "TestSuite"; "MetaRocq"],
                            "sle");
                         inductive_ind := 0
                       |} [])
                    [tRel 3; tRel 2];
                  tRel 0]]))))
     : term
{|
  mind_entry_record := None;
  mind_entry_finite := Finite;
  mind_entry_params := [];
  mind_entry_inds :=

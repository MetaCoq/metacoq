Inductive sle : nat -> nat -> SProp :=
    sle_0 : forall n : nat, sle 0 n
  | sle_S : forall n m : nat, sle n m -> sle (S n) (S m).

Arguments sle (_ _)%_nat_scope
Arguments sle_0 n%_nat_scope
Arguments sle_S (n m)%_nat_scope _
